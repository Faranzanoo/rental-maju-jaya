# ---------------------------------------------------------------
# Pengaturan Apache (butuh AllowOverride All; bawaan Laragon & XAMPP)
# Sintaks Apache 2.4 ke atas.
# ---------------------------------------------------------------

# Blokir file sensitif dan file pendukung yang tidak untuk dibuka langsung
<FilesMatch "\.(sql|md|log|ini|bak)$|^(config|config\.example|koneksi|fungsi)\.php$">
    Require all denied
</FilesMatch>

# Larang listing isi folder
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Header keamanan dasar
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "same-origin"
</IfModule>

# Catatan: tampil/sembunyi error PHP diatur dari config.php (APP_DEBUG),
# bukan php_flag di sini, supaya tidak error 500 di PHP FastCGI.
